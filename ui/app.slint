import { State } from "state.slint";
import { TScreen, TFinish } from "model.slint";
import { Menu } from "lego/menu.slint";
import { Board, Stats, Info } from "screens/screen.slint";
import { GDialog } from "lego/dialog.slint";
import { Reset-Board } from "dialogs/reset-board.slint";
import { Finish-Game } from "dialogs/finish.slint";

export { State }

// App entry
export component App inherits Window {
    in-out property <TScreen> screen <=> State.screen;

    callback show-finish();
    show-finish => {
        finish-board.show();
    }

    title: "RoF4";
    background: transparent;
    no-frame: true;
    resize-border-width: 5px;
    default-font-family: "Ubuntu";

    Rectangle {
        background: State.finish == TFinish.None ? #c42350 : #18ad29;
        border-width: 5px;
        border-color: self.background.brighter(0.25);
        border-radius: 20px;

        min-height: 600px;
        min-width: 540px;

        VerticalLayout {

            padding: 20px;
            spacing: 10px;

            Menu {
                close => {
                    root.hide();
                }

                reset-board => {
                    if (State.finish != TFinish.None) {
                        State.reset-board();
                    } else {
                        reset-board.show();
                    }
                }
            }

            if root.screen == TScreen.Board: Board {
                board <=> State.board;
            }

            if root.screen == TScreen.Stat: Stats { }

            if root.screen == TScreen.Info: Info { }
        }
    }

    reset-board := Reset-Board {
        height: root.height;
        width: root.width;
    }

    finish-board := Finish-Game {
        height: root.height;
        width: root.width;
    }
}
