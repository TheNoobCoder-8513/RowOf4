import {
    TBall,
    TBoard,
    TStat,
    TScreen,
    THelpScreen,
    TFinish,
} from "model.slint";



export global State {
    in-out property <TScreen> screen: TScreen.Info;
    in-out property <THelpScreen> help-screen: THelpScreen.Interface;

    in-out property <TBall> turn: TBall.User;
    public function updateTurn() {
        root.turn = root.turn == TBall.User ? TBall.CPU : TBall.User;
    }

    in-out property <{ row: int, col: int }> last-move: { row: -1, col: -1 };
    public function updateLastMove(rin: int, cin: int) {
        root.last-move.row = rin;
        root.last-move.col = cin;
    }

    in-out property <int> step-count: 0;

    in property <TStat> stat:  {
        match: 0,
        finished: 0,
        unfinished: 0,
        win: 0,
        tie: 0,
        lost: 0,
    };

    in-out property <TFinish> finish: TFinish.None;

    callback cell-clicked(int, int);
    callback reset-board();
    in-out property <TBoard> board: {
