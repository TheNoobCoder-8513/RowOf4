import { GDialog } from "../lego/dialog.slint";
import { State } from "../state.slint";
import { TFinish } from "../model.slint";


export component Reset-Board inherits PopupWindow {
    close-policy: no-auto-close;

    GDialog {
        message: State.finish == TFinish.None ? "Reset the board ?" : "Start a new game ?";
        buttons: ["No", "Yes"];

        clicked(in) => {
            root.close();
            if (in == 1) {
                State.reset-board();
            }
        }
    }
}
