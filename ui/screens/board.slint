import { Cell } from "../lego/cell.slint";
import { TBoard, TBall } from "../model.slint";
import { State } from "../state.slint";
import { Theme } from "../theme.slint";
export component Board inherits Rectangle {
    in-out property <TBoard> board;
    private property <TBall> turn <=> State.turn;

    background: Theme.board.base;
    border-radius: 20px;
    border-width: 5px;
    border-color: Theme.board.slot;

    GridLayout {
        padding: 15px;
        spacing: 10px;
        for row[rin] in board.board: Row {
            for elem[cin] in row: slot := Cell {
                slot: elem;
                isLast: State.last-move.col == cin && State.last-move.row == rin;

                clicked => {
                    State.cell-clicked(rin, cin);
                }
            }
        }
    }
}
